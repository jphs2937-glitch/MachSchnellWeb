# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Optional. Where new membership requests are sent. Defaults to contact.email in content/site.ts (info@mach-schnell.com)
MEMBERSHIP_TO_EMAIL=
# Optional. Sender. Defaults to "Mach Schnell <info@mach-schnell.com>"; mach-schnell.com must be verified in Resend
MEMBERSHIP_FROM_EMAIL=
# Optional. Public site URL. On Vercel it defaults to the production domain (mach-schnell.com)
NEXT_PUBLIC_SITE_URL=
