# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Where new membership requests are sent
MEMBERSHIP_TO_EMAIL=you@example.com
# Sender address on a domain verified in Resend. Until a domain is verified, use onboarding@resend.dev
MEMBERSHIP_FROM_EMAIL="Mach Schnell <onboarding@resend.dev>"
# Public site URL, used for canonical URLs, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=https://your-domain.com
